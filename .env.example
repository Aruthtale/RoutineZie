# Google Calendar & OAuth Configuration Template
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=your_g..._key
NEXT_PUBLIC_GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# Chat AI Configuration (Fase 5 - Chat AI)

# --- OPSI 1: Proxy sendiri (PALING AMAN, direkomendasikan untuk produksi publik) ---
# API key disimpan di server (Cloud Run/Vercel Functions), klien hanya panggil endpoint.
NEXT_PUBLIC_CHAT_PROXY_ENDPOINT=https://your-backend-endpoint.vercel.app/api/chat
NEXT_PUBLIC_CHAT_QUOTA_LIMIT=100

# --- OPSI 2: Proxy Cloudflare Worker (AMAN, direkomendasikan) ---
# API key disimpan sebagai Cloudflare Worker secret (TIDAK di bundle klien).
# Deploy: cd ~/Projects/routinezie-proxy && npx wrangler deploy --temporary
# Set secret: echo "$KEY" | npx wrangler secret put GEMINI_API_KEY --temporary
GEMINI_API_KEY=your_google_ai_studio_api_key_here
NEXT_PUBLIC_CHAT_PROXY_ENDPOINT=https://routinezie-chat-proxy.pie-coral.workers.dev/api/chat

# --- OPSI 3: Gemini API langsung (TIDAK AMAN untuk rilis publik) ---
# Dapatkan key di https://aistudio.google.com/apikey
# BAHAYA: pada mode static export, key ini DI-INLINE ke JS klien dan IKUT MASUK
#         KE APK. Jika APK dirilis publik (GitHub Releases), siapa pun bisa
#         mengunduh APK, mengekstrak key, dan memakai kuota kamu.
#         JANGAN pernah merilis APK publik dengan key ini aktif.
#         Untuk rilis publik WAJIB pakai OPSI 1 atau OPSI 2 (proxy).
#         scripts/release.sh akan MENOLAK rilis bila menemukan key di dalam APK.
# Autentikasi dilakukan via header x-goog-api-key (query param ?key= ditolak).
# NEXT_PUBLIC_GEMINI_API_KEY=your_g...n
# Model Gemini utama. Jika overload (503) / rate-limit (429), provider otomatis
# fallback ke: gemini-3.6-flash → gemini-3.5-flash → gemini-flash-latest
# Model populer: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
