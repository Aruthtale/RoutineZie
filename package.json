    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^1.16.0",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
